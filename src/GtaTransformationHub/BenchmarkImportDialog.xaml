<Window x:Class="GtaTransformationHub.BenchmarkImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benchmark metadata"
        Width="520" Height="590" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="PERFORMANCE CAPTURE" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
      <TextBlock Text="Record the test conditions alongside the PresentMon frame capture." FontSize="13" TextWrapping="Wrap" Margin="0,7,0,0"/>
      <TextBlock Text="Enter actual machine and game details. Missing GPU/temperature/VRAM measurements will not be inferred from frame-time data." Foreground="{StaticResource SecondaryText}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,12">
      <StackPanel>
        <TextBlock Text="GTA V Legacy executable version" FontSize="11" FontWeight="SemiBold"/>
        <TextBox x:Name="GameBuildText" Text="Unknown - enter detected GTA5.exe version" Margin="0,5,0,12" Padding="8"/>
        <TextBlock Text="Resolution" FontSize="11" FontWeight="SemiBold"/>
        <TextBox x:Name="ResolutionText" Text="1920x1080" Margin="0,5,0,12" Padding="8"/>
        <TextBlock Text="GPU model" FontSize="11" FontWeight="SemiBold"/>
        <TextBox x:Name="GpuText" Text="NVIDIA GeForce RTX 4050 Laptop GPU" Margin="0,5,0,12" Padding="8"/>
        <TextBlock Text="GPU driver version" FontSize="11" FontWeight="SemiBold"/>
        <TextBox x:Name="DriverText" Margin="0,5,0,12" Padding="8"/>
        <TextBlock Text="Active mod profile" FontSize="11" FontWeight="SemiBold"/>
        <TextBox x:Name="ProfileText" Text="Vanilla baseline" Margin="0,5,0,12" Padding="8"/>
        <TextBlock Text="Benchmark scenario / route" FontSize="11" FontWeight="SemiBold"/>
        <TextBox x:Name="ScenarioText" Text="Repeatable 90-second city route" Margin="0,5,0,12" Padding="8"/>
        <TextBlock Text="Notes (optional)" FontSize="11" FontWeight="SemiBold"/>
        <TextBox x:Name="NotesText" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" Padding="8"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="CANCEL" Padding="16,9" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="ANALYSE CSV" Padding="16,9" IsDefault="True" Click="AnalyseButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
