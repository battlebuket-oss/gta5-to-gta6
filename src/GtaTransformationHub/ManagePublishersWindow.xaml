<Window x:Class="GtaTransformationHub.ManagePublishersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trusted Publishers"
        Width="760" Height="560"
        MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        Loaded="Window_Loaded">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="PACKAGE TRUST" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
      <TextBlock Text="Trusted publisher keys" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/>
      <TextBlock Text="Removing a key immediately changes future preflight results for packages signed by it. Previously installed game files are not removed automatically." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,0"/>
    </StackPanel>

    <ListView x:Name="PublisherList"
              Grid.Row="1"
              AutomationProperties.Name="Trusted publisher keys"
              SelectionMode="Single"
              Background="#121419"
              BorderBrush="#343841"
              Foreground="{StaticResource PrimaryText}">
      <ListView.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="5,7">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Fingerprint}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding TrustedAt, StringFormat='Added: {0:u}'}" FontSize="10" Foreground="{StaticResource SecondaryText}"/>
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" Text="Loading trusted publishers..." Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Close" IsCancel="True" Padding="18,9" Margin="0,0,8,0"/>
        <Button x:Name="RemovePublisherButton" Content="Revoke selected key" Padding="18,9" Background="{StaticResource AccentBrush}" Foreground="White" IsEnabled="False" Click="RemovePublisherButton_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
