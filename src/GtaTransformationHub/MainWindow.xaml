<Window x:Class="GtaTransformationHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTA VI Transformation Hub"
        Width="1180" Height="760" MinWidth="980" MinHeight="640"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="TRANSFORMATION HUB" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="GTA V  /  MOD CONTROL" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#252830" CornerRadius="8" Padding="14,9" VerticalAlignment="Center">
        <TextBlock x:Name="SessionStateText" Text="CONFIGURATION UNLOCKED" FontSize="11" FontWeight="Bold"/>
      </Border>
    </DockPanel>

    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="16" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="GAME INSTALLATION" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold"/>
          <TextBlock x:Name="GamePathText" Text="GTA V Legacy not located" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="DetectionText" Text="Locate your GTA5.exe installation to begin." Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
        <Button x:Name="LocateButton" AutomationProperties.Name="Locate GTA V Legacy executable" Grid.Column="1" Content="Locate game" Padding="18,10" Margin="12,0" Click="LocateButton_Click"/>
        <Button x:Name="RefreshButton" AutomationProperties.Name="Recheck GTA V process and installation state" Grid.Column="2" Content="Recheck" Padding="18,10" Click="RefreshButton_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="18" Margin="0,0,10,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="MOD LOADOUT" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Import existing mod archives for inspection. Imported packages remain research-only until their build support, licence, hashes, conflicts and restore procedure are verified." Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <TextBlock x:Name="LibrarySummaryText" Text="Loading local research library..." Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="ManageModsButton" Content="MANAGE MOD TOGGLES" Padding="12,8" Margin="0,0,8,0" Click="ManageModsButton_Click"/>
              <TextBlock Text="Saved ON/OFF loadout · installation is separately gated" Foreground="{StaticResource SecondaryText}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="ImportArchiveButton" Content="IMPORT MOD ARCHIVE FOR REVIEW" Padding="12,8" Margin="0,0,8,0" Click="ImportArchiveButton_Click"/>
              <Button x:Name="RefreshLibraryButton" Content="REFRESH LIBRARY" Padding="12,8" Click="RefreshLibraryButton_Click"/>
            </StackPanel>
            <TextBlock Text="OPTIONAL OIV INSTALLER BRIDGE" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold" Margin="0,14,0,6"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SelectOivInstallerButton" Content="SELECT OIV ENGINE" Padding="10,7" Margin="0,0,8,0" Click="SelectOivInstallerButton_Click"/>
              <Button x:Name="OpenImportedOivButton" Content="OPEN IMPORTED OIV" Padding="10,7" Margin="0,0,8,0" IsEnabled="False" Click="OpenImportedOivButton_Click"/>
              <Button x:Name="GetOivInstallerButton" Content="GET OIV ENGINE" Padding="10,7" Click="GetOivInstallerButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="OivEngineStatusText" Text="No external installer selected. The Hub does not bundle third-party installers." Foreground="{StaticResource SecondaryText}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Button x:Name="RefreshOivInstallHistoryButton" Content="REFRESH OIV INSTALL RECORDS" Padding="10,7" Margin="0,8,0,0" HorizontalAlignment="Left" IsEnabled="False" Click="RefreshOivInstallHistoryButton_Click"/>
            <TextBlock x:Name="OivInstallHistoryText" Text="No CodeWalker OIV install records read. This checks installer backup logs only; it does not verify active mod files or gameplay." Foreground="{StaticResource SecondaryText}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Expander Header="OPENRAGE OIV INSTALLER · VERIFIED UPSTREAM TOOL"
                      Foreground="{StaticResource PrimaryText}" Margin="0,12,0,0"
                      IsExpanded="False">
              <StackPanel Margin="0,8,0,0">
                <TextBlock x:Name="OpenRageToolStatusText"
                           Text="OpenRAGE is not installed. Download and verify the pinned upstream v0.4.0 Windows x64 release."
                           Foreground="{StaticResource SecondaryText}" FontSize="10"
                           TextWrapping="Wrap"/>
                <WrapPanel Margin="0,8,0,0">
                  <Button x:Name="DownloadOpenRageButton" Content="DOWNLOAD &amp; VERIFY OPENRAGE"
                          Padding="9,7" Margin="0,0,6,6" Click="DownloadOpenRageButton_Click"/>
                  <Button x:Name="VerifyOpenRageButton" Content="VERIFY TOOL"
                          Padding="9,7" Margin="0,0,6,6" Click="VerifyOpenRageButton_Click"/>
                  <Button x:Name="PreviewOpenRageOivButton" Content="PREVIEW IMPORTED OIV"
                          Padding="9,7" Margin="0,0,6,6" Click="PreviewOpenRageOivButton_Click"/>
                  <Button x:Name="InstallReviewedOpenRageOivButton" Content="INSTALL REVIEWED OIV"
                          Padding="9,7" Margin="0,0,6,6" IsEnabled="False"
                          Click="InstallReviewedOpenRageOivButton_Click"/>
                </WrapPanel>
                <WrapPanel Margin="0,2,0,0">
                  <Button x:Name="ListOpenRageOivButton" Content="LIST INSTALLED OIVS"
                          Padding="9,7" Margin="0,0,6,6" Click="ListOpenRageOivButton_Click"/>
                  <Button x:Name="UndoOpenRageButton" Content="UNDO LATEST OPENRAGE CHANGE"
                          Padding="9,7" Margin="0,0,6,6" Click="UndoOpenRageButton_Click"/>
                </WrapPanel>
                <DockPanel Margin="0,2,0,0">
                  <TextBox x:Name="OpenRageUninstallGroupBox" Width="190"
                           Text="Enter exact OpenRAGE package group"
                           ToolTip="Enter the exact package group name returned by LIST INSTALLED OIVS."
                           VerticalContentAlignment="Center" Margin="0,0,6,6"/>
                  <Button x:Name="UninstallOpenRageOivButton" Content="UNINSTALL GROUP"
                          Padding="9,7" Margin="0,0,0,6" Click="UninstallOpenRageOivButton_Click"/>
                </DockPanel>
                <TextBox x:Name="OpenRageOutputText" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="#17191F" Foreground="#D5D9E0"
                         BorderThickness="0" MinHeight="55" MaxHeight="150"
                         Padding="7" FontSize="10"
                         Text="OpenRAGE preview/install results will appear here. Install requires an inspected OIV, clean archive hashes and explicit confirmation."/>
                <TextBlock Text="GTA VI HUD ROOT PLUGINS · TWO FILES ONLY"
                           Foreground="{StaticResource SecondaryText}" FontSize="10"
                           FontWeight="Bold" Margin="0,12,0,5"/>
                <WrapPanel>
                  <Button x:Name="DeployHudRootPluginsButton"
                          Content="DEPLOY VI HUD ROOT PLUGINS"
                          Padding="9,7" Margin="0,0,6,6"
                          IsEnabled="False" Click="DeployHudRootPluginsButton_Click"/>
                  <Button x:Name="RollbackHudRootPluginsButton"
                          Content="ROLL BACK VI HUD ROOT PLUGINS"
                          Padding="9,7" Margin="0,0,6,6"
                          IsEnabled="False" Click="RollbackHudRootPluginsButton_Click"/>
                </WrapPanel>
                <TextBlock x:Name="HudRootPluginStatusText"
                           Text="Select the GTA VI-Inspired HUD OIV. After its OIV install, the Hub can transactionally copy only ViMinimap.asi and ViPreload.asi from the mods folder to the GTA V root."
                           Foreground="{StaticResource SecondaryText}" FontSize="10"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
              </StackPanel>
            </Expander>
            <TextBlock Text="RTX 4050 / FRAME-TIME BENCHMARK" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold" Margin="0,14,0,6"/>
            <TextBlock x:Name="BenchmarkSummaryText" Text="No PresentMon capture analysed yet. Capture baseline and modded runs using identical conditions." Foreground="{StaticResource SecondaryText}" FontSize="10" TextWrapping="Wrap"/>
            <Button x:Name="ImportBenchmarkButton" Content="IMPORT PRESENTMON CSV" Padding="10,7" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ImportBenchmarkButton_Click"/>
          </StackPanel>
          <TextBlock Text="LOCAL IMPORTED PACKAGES" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold" Margin="0,4,0,8"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ModList">
              <TextBlock Text="No local research packages imported yet." Foreground="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <StackPanel Grid.Column="1">
        <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="18" Margin="10,0,0,12">
          <StackPanel>
            <TextBlock Text="DEFAULT EXPERIENCE" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Story Mode + World Expansion" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,4"/>
            <TextBlock Text="The original GTA V campaign stays intact. Separate profiles will manage verified story packs, side activities, world systems and visual changes." Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="18" Margin="10,0,0,12">
          <StackPanel>
            <TextBlock Text="ACCESSIBILITY" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Accessibility is a core track: subtitle readability, screen-reader compatibility, clear controls, scalable UI, contrast and motion comfort." TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="Catalogue candidates are research-only until individually verified. Unsupported settings will never appear as working toggles." Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="18" Margin="10,0,0,0">
          <StackPanel>
            <TextBlock Text="SESSION SAFETY" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Once GTA5.exe starts, all configuration controls lock. The app will not deploy, remove, or change mods until the game exits." TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="LockExplanationText" Text="Game not running — configuration is available." Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <DockPanel Grid.Row="3" Margin="0,18,0,0">
      <TextBlock x:Name="StatusText" Text="Ready. Locate GTA V Legacy to continue." Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
      <Button x:Name="LaunchButton" AutomationProperties.Name="Apply validated Story Mode profile and launch GTA V" DockPanel.Dock="Right" Content="APPLY PROFILE &amp; LAUNCH" Padding="24,13" FontWeight="Bold" Background="{StaticResource AccentBrush}" Foreground="White" IsEnabled="False" Click="LaunchButton_Click"/>
    </DockPanel>
  </Grid>
</Window>
