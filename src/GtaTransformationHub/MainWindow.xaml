<Window x:Class="GtaTransformationHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTA V Transformation Hub"
        Width="1220" Height="800" MinWidth="1000" MinHeight="680"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="GTA V TRANSFORMATION HUB" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="STORY MODE / MOD CONTROL" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#252830" CornerRadius="8" Padding="14,9" VerticalAlignment="Center">
        <TextBlock x:Name="SessionStateText" Text="STARTING SAFETY CHECK" FontSize="11" FontWeight="Bold"/>
      </Border>
    </DockPanel>

    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="16" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="GAME INSTALLATION" Foreground="{StaticResource SecondaryText}" FontSize="10" FontWeight="Bold"/>
          <TextBlock x:Name="GamePathText" Text="GTA V Legacy not located" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="DetectionText" Text="Select GTA5.exe to verify the installation and build." Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
        <Button x:Name="LocateButton" AutomationProperties.Name="Locate GTA V Legacy executable" Grid.Column="1" Content="Locate game" Padding="18,10" Margin="12,0" Click="LocateButton_Click"/>
        <Button x:Name="RefreshButton" AutomationProperties.Name="Recheck GTA V process and installation state" Grid.Column="2" Content="Recheck" Padding="18,10" Click="RefreshButton_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.8*"/>
        <ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="18" Margin="0,0,10,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="PACKAGE LIBRARY" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Import a ZIP containing gta-hub-manifest.json. Applying a profile reconciles installed packages and preserves an intact package that is already active." Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
          </StackPanel>

          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="ImportPackageButton" Content="Import package ZIP" Padding="14,9" Margin="0,0,8,0" Click="ImportPackageButton_Click"/>
            <Button x:Name="TrustPublisherButton" Content="Trust publisher key" Padding="14,9" Margin="0,0,8,0" Click="TrustPublisherButton_Click"/>
            <Button x:Name="ManagePublishersButton" Content="Manage trusted keys" Padding="14,9" Margin="0,0,8,0" Click="ManagePublishersButton_Click"/>
            <Button x:Name="ValidateButton" Content="Validate selection" Padding="14,9" Margin="0,0,8,0" IsEnabled="False" Click="ValidateButton_Click"/>
            <Button x:Name="ApplyButton" Content="Apply profile" Padding="14,9" Margin="0,0,8,0" IsEnabled="False" Background="{StaticResource AccentBrush}" Foreground="White" Click="ApplyButton_Click"/>
            <Button x:Name="RemoveSelectedButton" Content="Remove selected" Padding="14,9" Margin="0,0,8,0" IsEnabled="False" Click="RemoveSelectedButton_Click"/>
            <Button x:Name="RollbackButton" Content="Rollback latest" Padding="14,9" IsEnabled="False" Click="RollbackButton_Click"/>
          </WrapPanel>

          <CheckBox x:Name="TrustPackagesCheckBox"
                    DockPanel.Dock="Top"
                    Margin="0,0,0,12"
                    IsEnabled="False"
                    Checked="TrustAcknowledgement_Changed"
                    Unchecked="TrustAcknowledgement_Changed"
                    Content="I reviewed the source and licence, and accept that third-party mod files may execute inside GTA V."/>

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="PACKAGE ACQUISITION" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
            <TextBox x:Name="PackageDownloadUrlText" AutomationProperties.Name="Direct HTTPS package download URL" ToolTip="Paste a direct HTTPS ZIP or OIV download URL" Padding="8" Margin="0,0,0,6"/>
            <Button x:Name="DownloadPackageButton" Content="Download package from direct HTTPS URL" Padding="10,7" HorizontalAlignment="Left" Click="DownloadPackageButton_Click"/>
            <TextBlock Text="Direct HTTPS ZIP/OIV files only. Redirects are revalidated, downloads are size-limited, and HTML pages are not scraped." Foreground="{StaticResource SecondaryText}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="Select one or more imported packages:" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,8"/>
          <Expander x:Name="ResearchCatalogueExpander"
                    DockPanel.Dock="Bottom"
                    Header="RESEARCH CATALOGUE — UNAPPROVED MODS"
                    IsExpanded="False"
                    Margin="0,12,0,0">
            <ListBox x:Name="ResearchCatalogueList"
                     AutomationProperties.Name="Research-only mod catalogue"
                     Height="190"
                     Background="#121419"
                     BorderBrush="#343841"
                     Foreground="{StaticResource PrimaryText}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="5,5">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Author}" Foreground="{StaticResource SecondaryText}" FontSize="10"/>
                    <TextBlock Text="{Binding Version}" Foreground="{StaticResource SecondaryText}" FontSize="10"/>
                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" FontSize="10" MaxHeight="42"/>
                    <TextBlock Text="{Binding Status, StringFormat='Catalogue status: {0}'}" Foreground="{StaticResource SecondaryText}" FontSize="10"/>
                    <Button Content="Open mod author/source page"
                            Tag="{Binding SourceUri}"
                            HorizontalAlignment="Left"
                            Padding="8,4"
                            Margin="0,4,0,0"
                            Click="OpenCatalogueSourceButton_Click"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Expander>

          <ListBox x:Name="PackageList"
                   AutomationProperties.Name="Imported mod packages"
                   SelectionMode="Extended"
                   SelectionChanged="PackageList_SelectionChanged"
                   Background="#121419"
                   BorderBrush="#343841"
                   Foreground="{StaticResource PrimaryText}">
            <ListBox.ItemTemplate>
                            <DataTemplate>
                <StackPanel Margin="5,4">
                  <TextBlock Text="{Binding Manifest.Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Manifest.Author}" Foreground="{StaticResource SecondaryText}" FontSize="11"/>
                  <TextBlock Text="{Binding Manifest.Id}" Foreground="{StaticResource SecondaryText}" FontSize="10"/>
                  <TextBlock Text="{Binding Manifest.Licence}" Foreground="{StaticResource SecondaryText}" FontSize="10" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SignatureStatus, StringFormat='Signature: {0}'}" Foreground="{StaticResource SecondaryText}" FontSize="10"/>
                  <Button Content="Open author/source page"
                          Tag="{Binding Manifest.SourceUri}"
                          HorizontalAlignment="Left"
                          Padding="8,4"
                          Margin="0,5,0,0"
                          Click="OpenPackageSourceButton_Click"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <StackPanel Grid.Column="1">
        <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="18" Margin="10,0,0,12">
          <StackPanel>
            <TextBlock Text="PROFILES" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a saved profile, then save the current package selection as a profile." Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
            <ComboBox x:Name="ProfileSelector"
                      AutomationProperties.Name="Saved package profile"
                      DisplayMemberPath="Name"
                      SelectionChanged="ProfileSelector_SelectionChanged"
                      Margin="0,0,0,8"/>
            <TextBox x:Name="ProfileNameText" AutomationProperties.Name="New profile name" ToolTip="Enter a name for the current package selection" Margin="0,0,0,8" Padding="8"/>
            <Button x:Name="SaveProfileButton" Content="Save current selection as profile" Padding="12,9" Click="SaveProfileButton_Click"/>
            <TextBlock x:Name="ProfileWarningText" Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="18" Margin="10,0,0,12">
          <StackPanel>
            <TextBlock Text="ECOLOGICAL FIDELITY" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Preserve the original GTA V animal, plant and vegetation species, their model identities and species spawn tables. Visual improvements such as higher-resolution textures, lighting, shadows and animation are allowed only when species identities remain unchanged. Ecology-sensitive packages without an approved preservation review are blocked." TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="18" Margin="10,0,0,12">
          <StackPanel>
            <TextBlock Text="STORY MODE FIRST" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="The project targets GTA V Legacy single-player. Preserve original game files and saves. Imported packages remain separate until a selected deployment is applied." TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="18" Margin="10,0,0,12">
          <StackPanel>
            <TextBlock Text="ACCESSIBILITY" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="The Hub uses standard Windows controls and keyboard navigation. Game-side subtitle, screen-reader, HUD and comfort features are shown only when an actual compatible implementation is verified." TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="18" Margin="10,0,0,0">
          <StackPanel>
            <TextBlock Text="SESSION SAFETY" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Configuration and deployment are locked while GTA5.exe is running or process state is uncertain. The deployer copies declared files only and does not execute installers." TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="LockExplanationText" Text="Waiting for startup recovery." Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <DockPanel Grid.Row="3" Margin="0,18,0,0">
      <TextBlock x:Name="StatusText" Text="Checking deployment recovery..." Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button x:Name="LaunchButton"
              AutomationProperties.Name="Launch GTA V Story Mode after verified package deployment"
              DockPanel.Dock="Right"
              Content="LAUNCH GTA V"
              Padding="24,13"
              Margin="12,0,0,0"
              FontWeight="Bold"
              Background="{StaticResource AccentBrush}"
              Foreground="White"
              IsEnabled="False"
              Click="LaunchButton_Click"/>
    </DockPanel>
  </Grid>
</Window>
