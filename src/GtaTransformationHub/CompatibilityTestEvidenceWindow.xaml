<Window x:Class="GtaTransformationHub.CompatibilityTestEvidenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compatibility and Performance Test Evidence"
        Width="1180" Height="900" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="370">
      <StackPanel Margin="0,0,0,12">
        <TextBlock Text="COMPATIBILITY / PERFORMANCE TEST EVIDENCE" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="GameSummaryText" Margin="0,5,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="PackageStackText" Margin="0,3,0,9" TextWrapping="Wrap"/>
        <TextBlock Text="Test environment" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <TextBlock Text="Record exact CPU, GPU and driver, VRAM, installed RAM, Windows version, launcher, game resolution/refresh, graphics settings and mod loader/runtime versions. Do not include account credentials." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="TestEnvironmentTextBox"
                 AutomationProperties.Name="Compatibility test environment details"
                 Height="65" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="7"/>
        <TextBlock Text="Summary and reproducible issues" FontWeight="SemiBold" Margin="0,8,0,3"/>
        <TextBox x:Name="SummaryTextBox"
                 AutomationProperties.Name="Overall compatibility test summary"
                 Height="48" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="7"/>

        <Expander Header="PERFORMANCE MEASUREMENTS" IsExpanded="True" Margin="0,10,0,0">
          <StackPanel Margin="0,8,0,0">
            <CheckBox x:Name="WarmupCompletedCheckBox" Content="Warm-up pass completed" Margin="0,0,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,7">
                <TextBlock Text="Benchmark repeats" FontSize="10"/>
                <TextBox x:Name="BenchmarkRepeatsTextBox" Text="0" Padding="5"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,7">
                <TextBlock Text="Average FPS" FontSize="10"/>
                <TextBox x:Name="AverageFpsTextBox" Padding="5"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,7">
                <TextBlock Text="1% low FPS" FontSize="10"/>
                <TextBox x:Name="OnePercentLowFpsTextBox" Padding="5"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,7">
                <TextBlock Text="P95 frame time (ms)" FontSize="10"/>
                <TextBox x:Name="FrameTimeP95TextBox" Padding="5"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,7">
                <TextBlock Text="P99 frame time (ms)" FontSize="10"/>
                <TextBox x:Name="FrameTimeP99TextBox" Padding="5"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,7">
                <TextBlock Text="Peak system RAM (MB)" FontSize="10"/>
                <TextBox x:Name="PeakSystemRamTextBox" Padding="5"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,7">
                <TextBlock Text="Peak VRAM (MB)" FontSize="10"/>
                <TextBox x:Name="PeakVramTextBox" Padding="5"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,7">
                <TextBlock Text="Soak duration (minutes)" FontSize="10"/>
                <TextBox x:Name="SoakDurationTextBox" Text="0" Padding="5"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Peak GPU temperature (°C)" FontSize="10"/>
                <TextBox x:Name="PeakGpuTemperatureTextBox" Padding="5"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Peak CPU temperature (°C)" FontSize="10"/>
                <TextBox x:Name="PeakCpuTemperatureTextBox" Padding="5"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="A Passed performance benchmark requires a completed warm-up, at least three repeats, FPS/frame-time/RAM/VRAM measurements. A Passed soak requires at least 60 minutes." TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <DataGrid x:Name="ScenarioGrid"
              Grid.Row="1"
              AutomationProperties.Name="Required compatibility and performance test scenarios"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              AlternationCount="2"
              RowHeight="44"
              SelectionMode="Single"
              SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Required scenario" Binding="{Binding Name}" IsReadOnly="True" Width="245"/>
        <DataGridTemplateColumn Header="Result" Width="130">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Outcome}" VerticalAlignment="Center" Margin="5,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.AvailableOutcomes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        SelectedItem="{Binding Outcome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Compatibility scenario result"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Reproduction notes / evidence reference"
                            Binding="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="EvidenceStatusText"
                 Text="Not-run scenarios remain incomplete. Saving evidence never approves a mod or changes its catalogue status."
                 TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button Grid.Column="1" Content="Cancel" Padding="16,9" Margin="0,0,8,0" IsCancel="True"/>
      <Button Grid.Column="2" Content="Save test evidence" Padding="16,9" IsDefault="True" Click="SaveEvidenceButton_Click"/>
    </Grid>
  </Grid>
</Window>
