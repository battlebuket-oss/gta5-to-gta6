<Window x:Class="GtaTransformationHub.StoryTestEvidenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Story Mode Test Evidence"
        Width="1050" Height="820" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="STORY MODE TEST EVIDENCE" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="PackageSummaryText" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="GameFingerprintText" Margin="0,3,0,9" TextWrapping="Wrap"/>
      <TextBlock Text="Test environment" FontWeight="SemiBold" Margin="0,0,0,3"/>
      <TextBlock Text="Record Windows version, CPU, GPU and VRAM, RAM, GPU driver, launcher, display resolution/refresh, and the game settings used. Do not record account credentials." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"/>
      <TextBox x:Name="TestEnvironmentTextBox"
               AutomationProperties.Name="Story Mode test environment details"
               Height="65" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" Padding="7"/>
      <TextBlock Text="Overall notes / reproducible defects" FontWeight="SemiBold" Margin="0,8,0,3"/>
      <TextBox x:Name="SummaryTextBox"
               AutomationProperties.Name="Overall Story Mode test notes"
               Height="48" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" Padding="7"/>
    </StackPanel>

    <DataGrid x:Name="ScenarioGrid"
              Grid.Row="1"
              AutomationProperties.Name="Required Story Mode test scenarios and results"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              AlternationCount="2"
              RowHeight="48"
              SelectionMode="Single"
              SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Required test" Binding="{Binding Name}" IsReadOnly="True" Width="220"/>
        <DataGridTemplateColumn Header="Result" Width="130">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Outcome}" VerticalAlignment="Center" Margin="5,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.AvailableOutcomes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        SelectedItem="{Binding Outcome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Test scenario result"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Tester notes / evidence reference"
                            Binding="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="EvidenceStatusText"
                 Text="Not-run scenarios remain explicitly incomplete. Saving a record never approves or unlocks a package."
                 TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button Grid.Column="1" Content="Cancel" Padding="16,9" Margin="0,0,8,0" IsCancel="True"/>
      <Button Grid.Column="2" Content="Save test evidence" Padding="16,9" IsDefault="True" Click="SaveEvidenceButton_Click"/>
    </Grid>
  </Grid>
</Window>
